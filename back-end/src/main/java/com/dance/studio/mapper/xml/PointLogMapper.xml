<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dance.studio.mapper.PointLogMapper">

    <resultMap id="BaseMap" type="com.dance.studio.entity.PointLog">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="type" property="type"/>
        <result column="amount" property="amount"/>
        <result column="balance_after" property="balanceAfter"/>
        <result column="ref_type" property="refType"/>
        <result column="ref_id" property="refId"/>
        <result column="operator_id" property="operatorId"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO point_log (user_id, type, amount, balance_after, ref_type, ref_id, operator_id, remark)
        VALUES (#{userId}, #{type}, #{amount}, #{balanceAfter}, #{refType}, #{refId}, #{operatorId}, #{remark})
    </insert>

    <select id="listByUser" resultMap="BaseMap">
        SELECT * FROM point_log WHERE user_id = #{userId} ORDER BY id DESC
    </select>
</mapper>

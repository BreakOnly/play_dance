<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dance.studio.mapper.NoticeMapper">

    <resultMap id="EntityMap" type="com.dance.studio.entity.Notice">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="name" property="name"/>
        <result column="content" property="content"/>
        <result column="sort" property="sort"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <select id="listByStore" resultMap="EntityMap">
        SELECT * FROM notice
        WHERE store_id = #{storeId}
        <if test="onlyEnabled">AND status = 1</if>
        ORDER BY sort, id
    </select>

    <select id="findById" resultMap="EntityMap">
        SELECT * FROM notice WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO notice (store_id, name, content, sort, status)
        VALUES (#{storeId}, #{name}, #{content}, COALESCE(#{sort},0), COALESCE(#{status},1))
    </insert>

    <update id="update">
        UPDATE notice
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="content != null">content = #{content},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id} AND store_id = #{storeId}
    </update>

    <delete id="deleteById">
        DELETE FROM notice WHERE id = #{id} AND store_id = #{storeId}
    </delete>
</mapper>

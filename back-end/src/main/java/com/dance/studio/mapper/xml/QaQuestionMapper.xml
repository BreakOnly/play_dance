<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dance.studio.mapper.QaQuestionMapper">

    <resultMap id="BaseMap" type="com.dance.studio.entity.QaQuestion">
        <id column="id" property="id"/>
        <result column="store_id" property="storeId"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="images" property="images"/>
        <result column="answer_count" property="answerCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <resultMap id="VoMap" type="com.dance.studio.vo.QaQuestionVo">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="answer_count" property="answerCount"/>
        <result column="like_count" property="likeCount"/>
        <result column="author_name" property="authorName"/>
        <result column="author_avatar" property="authorAvatar"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="liked" property="liked"/>
    </resultMap>

    <sql id="voSelect">
        SELECT q.id, q.user_id, q.content, q.answer_count, q.like_count, q.status, q.created_at,
               s.name AS author_name, s.avatar AS author_avatar,
               <if test="viewerId != null">
               EXISTS (SELECT 1 FROM like_record lr
                        WHERE lr.user_id = #{viewerId} AND lr.target_type = 'question'
                          AND lr.target_id = q.id) AS liked,
               </if>
               <if test="viewerId == null">
               0 AS liked,
               </if>
        FROM qa_question q
        LEFT JOIN `user` s ON s.id = q.user_id
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO qa_question (store_id, user_id, content, images, status)
        VALUES (#{storeId}, #{userId}, #{content}, #{images}, 1)
    </insert>

    <select id="findById" resultMap="BaseMap">
        SELECT * FROM qa_question WHERE id = #{id}
    </select>

    <select id="list" resultMap="VoMap">
        <include refid="voSelect"/>
        WHERE q.store_id = #{storeId} AND q.status = 1
        ORDER BY q.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM qa_question WHERE store_id = #{storeId} AND status = 1
    </select>

    <!-- 后台：含隐藏问题 -->
    <select id="listAdmin" resultMap="VoMap">
        <include refid="voSelect"/>
        WHERE q.store_id = #{storeId}
        ORDER BY q.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAdmin" resultType="int">
        SELECT COUNT(*) FROM qa_question WHERE store_id = #{storeId}
    </select>

    <select id="findVoById" resultMap="VoMap">
        <include refid="voSelect"/>
        WHERE q.id = #{id} AND q.status = 1
    </select>

    <update id="changeLikeCount">
        UPDATE qa_question SET like_count = like_count + #{delta}
        WHERE id = #{id} AND like_count + #{delta} &gt;= 0
    </update>

    <update id="updateStatus">
        UPDATE qa_question SET status = #{status} WHERE id = #{id}
    </update>

    <update id="incrAnswerCount">
        UPDATE qa_question SET answer_count = answer_count + 1 WHERE id = #{id}
    </update>
</mapper>
